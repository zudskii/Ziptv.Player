# Used by docker-compose.yml. Copy to .env and fill in.
# Generate two DIFFERENT stable values with: openssl rand -base64 48
# Set both before docker compose up; keep existing values when redeploying.
STREAM_TOKEN_SECRET=
DATA_ENCRYPTION_KEY=

# 0 locally; 1 behind one reverse proxy (Render), 2 behind Cloudflare + Render.
TRUST_PROXY=0
ALLOW_PRIVATE_UPSTREAMS=false
LOG_LEVEL=info
PORT=8080
MONGO_PORT=27018