# Used by docker-compose.yml. Copy to .env and fill in.
# Generate STREAM_TOKEN_SECRET and DATA_ENCRYPTION_KEY (two DIFFERENT, stable values) with: openssl rand -base64 48
# Set all three before `docker compose up`; keep existing values when redeploying.
# Changing DATA_ENCRYPTION_KEY makes stored provider credentials unreadable.
POSTGRES_PASSWORD=
STREAM_TOKEN_SECRET=
DATA_ENCRYPTION_KEY=

# 0 locally; 1 behind one reverse proxy (Render), 2 behind Cloudflare + Render.
TRUST_PROXY=0
ALLOW_PRIVATE_UPSTREAMS=false
LOG_LEVEL=info
PORT=8080
POSTGRES_PORT=5433

# Email: forgotten passwords and address confirmation. Optional; without it those features are off.
# Set all three (PUBLIC_URL is where users reach ZIPTV; links in emails are built from it, never from a request).
# PUBLIC_URL=https://tv.example.com
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="ZIPTV <no-reply@example.com>"

# --- Operator console (separate listener; see README "Operator console") ---
# Published on 127.0.0.1 by docker-compose; reach it through SSH/VPN.
# ADMIN_PORT=8081
# ADMIN_BIND=127.0.0.1

# --- Delivery & shared state (see docs/architecture/THREAT_MODEL.md) ---
# auto  = direct playback when the browser can (users' own sources);
# proxy = upstream URLs/credentials never reach clients (operator / licensed content).
STREAM_DELIVERY=auto
# Export links: direct | proxied | off  (default: direct, proxied when STREAM_DELIVERY=proxy).
# PLAYLIST_EXPORT_MODE=
# Shared rate limits / cache invalidation / leases. Required as soon as more than one app
# instance runs. `docker compose --profile redis up -d` starts the bundled Redis:
# REDIS_URL=redis://redis:6379/0
# Namespace when several deployments share one Redis.
# REDIS_KEY_PREFIX=ziptv:
