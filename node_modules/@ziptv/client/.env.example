# Base URL of the ZIPTV API, *without* a trailing slash.
# Leave empty when the API is served from the same origin (docker-compose/nginx, or `npm run dev` with the Vite proxy).
# Example for separate hosting: VITE_API_URL=https://m3u-server.onrender.com
VITE_API_URL=

# Dev only: where the Vite dev server proxies /api to.
VITE_DEV_API_TARGET=http://localhost:8080
