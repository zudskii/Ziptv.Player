# Copy to apps/server/.env for local development (loaded automatically by `npm run dev`).
# In production the platform injects these variables; never commit a real .env.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# PostgreSQL. Local example (docker compose publishes it on 127.0.0.1:5433):
#   DATABASE_URL=postgres://ziptv:<POSTGRES_PASSWORD>@localhost:5433/ziptv
# Managed databases usually need TLS: append ?sslmode=require
DATABASE_URL=postgres://ziptv:change-me@localhost:5433/ziptv
# Connections in this process's pool.
DATABASE_POOL_MAX=10

# Browser origins allowed to call the JSON API when the client is hosted elsewhere.
# Not needed for same-origin setups (Docker image, Vite dev proxy).
CORS_ORIGINS=http://localhost:5173

# Number of reverse-proxy hops in front of the app (Render: 1, Cloudflare + Render: 2).
TRUST_PROXY=0

# Required in production, >= 32 chars (openssl rand -base64 48). Signs stream-proxy URLs.
STREAM_TOKEN_SECRET=
# Required in production. Keep this value stable or existing provider credentials cannot be decrypted.
DATA_ENCRYPTION_KEY=
STREAM_TOKEN_TTL_SECONDS=21600
STREAM_PROXY_ENABLED=true

# Many IPTV panels only answer "player" user agents. Channels can override it.
UPSTREAM_USER_AGENT=VLC/3.0.21 LibVLC/3.0.21
UPSTREAM_CONNECT_TIMEOUT_MS=10000
UPSTREAM_HEADERS_TIMEOUT_MS=15000
UPSTREAM_BODY_TIMEOUT_MS=30000
# Only for self-hosting at home with LAN sources. Keep false on anything public (SSRF).
ALLOW_PRIVATE_UPSTREAMS=false

MAX_SOURCE_BYTES=31457280
MAX_ENTRIES_PER_SOURCE=150000
MAX_SOURCES_PER_USER=30

# Account sessions expire after this many days without use (guest sessions never expire).
SESSION_TTL_DAYS=90
MAX_PROFILES_PER_USER=6

# Optional: serve the built client from this server (single-origin deployment).
# CLIENT_DIST_DIR=../client/dist
