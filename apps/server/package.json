{
  "name": "@ziptv/server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "parse": "tsx src/scripts/parse-file.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "staff": "tsx src/cli/staff.ts"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "htmlparser2": "^12.0.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "kysely": "^0.29.6",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "undici": "^7.29.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^6.0.3",
    "@ziptv/contracts": "*",
    "mailparser": "^3.9.46",
    "pino-pretty": "^13.1.1",
    "smtp-server": "^3.20.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
