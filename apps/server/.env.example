# Copy to apps/server/.env for local development (loaded automatically by `npm run dev`).
# In production the platform injects these variables; never commit a real .env.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# PostgreSQL. Local example (docker compose publishes it on 127.0.0.1:5433):
#   DATABASE_URL=postgres://ziptv:<POSTGRES_PASSWORD>@localhost:5433/ziptv
# Managed databases usually need TLS: append ?sslmode=require
DATABASE_URL=postgres://ziptv:change-me@localhost:5433/ziptv
# Connections in this process's pool.
DATABASE_POOL_MAX=10

# Browser origins allowed to call the JSON API when the client is hosted elsewhere.
# Not needed for same-origin setups (Docker image, Vite dev proxy).
CORS_ORIGINS=http://localhost:5173

# Number of reverse-proxy hops in front of the app (Render: 1, Cloudflare + Render: 2).
TRUST_PROXY=0

# Required in production, >= 32 chars (openssl rand -base64 48). Encrypts stream/image proxy tokens.
STREAM_TOKEN_SECRET=
# Required in production. Keep this value stable or existing provider credentials cannot be decrypted.
DATA_ENCRYPTION_KEY=
STREAM_TOKEN_TTL_SECONDS=21600
STREAM_PROXY_ENABLED=true
# auto = direct playback when possible (own sources); proxy = never expose upstream URLs (operator content).
STREAM_DELIVERY=auto
# direct | proxied | off — default: direct, or proxied when STREAM_DELIVERY=proxy.
# PLAYLIST_EXPORT_MODE=
# Lifetime of proxy URLs inside exported playlists (hours).
# PLAYLIST_EXPORT_LINK_TTL_HOURS=168

# Shared state for more than one instance (rate limits, cache invalidation, leases).
# Unset = per-instance memory (fine for a single instance).
# REDIS_URL=redis://localhost:6379/0
# REDIS_KEY_PREFIX=ziptv:

# Many IPTV panels only answer "player" user agents. Channels can override it.
UPSTREAM_USER_AGENT=VLC/3.0.21 LibVLC/3.0.21
UPSTREAM_CONNECT_TIMEOUT_MS=10000
UPSTREAM_HEADERS_TIMEOUT_MS=15000
UPSTREAM_BODY_TIMEOUT_MS=30000
# Only for self-hosting at home with LAN sources. Keep false on anything public (SSRF).
ALLOW_PRIVATE_UPSTREAMS=false

# Programme guide (XMLTV): refresh interval, days kept ahead, decompressed size cap of one file.
EPG_SYNC_INTERVAL_HOURS=3
EPG_DAYS_AHEAD=7
# EPG_MAX_BYTES=536870912
EPG_SYNC_CONCURRENCY=1

MAX_SOURCE_BYTES=31457280
MAX_ENTRIES_PER_SOURCE=150000
MAX_SOURCES_PER_USER=30

# Playlists a user can build, and channels per playlist (not the same as MAX_SOURCES_PER_USER).
MAX_CUSTOM_PLAYLISTS_PER_USER=20
MAX_ENTRIES_PER_CUSTOM_PLAYLIST=50000
# Origin used in playlist export links, e.g. https://tv.example.com (default: the request's own origin).
# PUBLIC_URL=

# Email (forgotten password, address confirmation). Optional: without it those features are off.
# Any SMTP provider works. URL-encode special characters in the password (@ → %40, : → %3A, / → %2F).
# PUBLIC_URL, SMTP_URL and MAIL_FROM go together.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="ZIPTV <no-reply@example.com>"
# Development only: print emails (with their links) to the log instead of sending them.
# MAIL_LOG_ONLY=true

# Account sessions expire after this many days without use (guest sessions never expire).
SESSION_TTL_DAYS=90
MAX_PROFILES_PER_USER=6

# Operator console: its own listener (own origin). 0 disables it on this instance.
ADMIN_PORT=8081
# ADMIN_HOST=127.0.0.1
# ADMIN_DIST_DIR=../admin/dist
# ADMIN_SESSION_IDLE_MINUTES=30
# ADMIN_SESSION_MAX_HOURS=12

# Optional: serve the built client from this server (single-origin deployment).
# CLIENT_DIST_DIR=../client/dist
